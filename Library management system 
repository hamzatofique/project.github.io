-- ── 8. Most Borrowed Books ────────────────────────────
SELECT
    b.title,
    a.full_name            AS author,
    COUNT(br.borrow_id)    AS times_borrowed
FROM Borrowings br
JOIN Books   b ON br.book_id   = b.book_id
JOIN Authors a ON b.author_id  = a.author_id
GROUP BY b.book_id, b.title, a.full_name
ORDER BY times_borrowed DESC
LIMIT 5;


-- ── 9. Members with Overdue Books ────────────────────
SELECT
    m.full_name,
    m.phone,
    b.title,
    br.due_date,
    DATEDIFF(CURRENT_DATE, br.due_date) AS days_overdue,
    DATEDIFF(CURRENT_DATE, br.due_date) * 25 AS fine_rs
FROM Borrowings br
JOIN Members m ON br.member_id = m.member_id
JOIN Books   b ON br.book_id   = b.book_id
WHERE br.status = 'Overdue'
   OR (br.status = 'Borrowed'
       AND br.due_date < CURRENT_DATE)
ORDER BY days_overdue DESC;


-- ── 10. Member Borrowing History ─────────────────────
SELECT
    br.borrow_id,
    b.title,
    br.borrow_date,
    br.due_date,
    COALESCE(br.return_date, 'Not Returned') AS return_date,
    br.status,
    COALESCE(f.amount, 0)                    AS fine_rs
FROM Borrowings br
JOIN Books  b  ON br.book_id  = b.book_id
LEFT JOIN Fines f ON br.borrow_id = f.borrow_id
WHERE br.member_id = 1
ORDER BY br.borrow_date DESC;


-- ── 11. Genre Popularity Report ──────────────────────
SELECT
    b.genre,
    COUNT(br.borrow_id)  AS total_borrowed,
    COUNT(DISTINCT b.book_id) AS unique_books
FROM Borrowings br
JOIN Books b ON br.book_id = b.book_id
GROUP BY b.genre
ORDER BY total_borrowed DESC;


-- ── 12. Unpaid Fines Report ───────────────────────────
SELECT
    m.full_name,
    m.phone,
    SUM(f.amount)        AS total_fine_rs,
    COUNT(f.fine_id)     AS fine_count
FROM Fines f
JOIN Members m ON f.member_id = m.member_id
WHERE f.paid = FALSE
GROUP BY m.member_id, m.full_name, m.phone
ORDER BY total_fine_rs DESC;


-- ── 13. Library Summary Dashboard ────────────────────
SELECT 'Total Books'         AS metric,
        COUNT(*)             AS value FROM Books
UNION ALL
SELECT 'Total Members',       COUNT(*) FROM Members
UNION ALL
SELECT 'Active Borrowings',   COUNT(*) FROM Borrowings
       WHERE status = 'Borrowed'
UNION ALL
SELECT 'Overdue Books',       COUNT(*) FROM Borrowings
       WHERE status = 'Overdue'
       OR (status = 'Borrowed' AND due_date < CURRENT_DATE)
UNION ALL
SELECT 'Unpaid Fines (Rs.)',  COALESCE(SUM(amount), 0)
       FROM Fines WHERE paid = FALSE;


