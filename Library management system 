--   STORED PROCEDURES
-- ══════════════════════════════════════════════════════

DELIMITER $$

-- ── Procedure: Borrow Book ────────────────────────────
CREATE PROCEDURE BorrowBook(
    IN  p_member_id INT,
    IN  p_book_id   INT,
    OUT p_message   VARCHAR(200)
)
BEGIN
    DECLARE avail INT;
    SELECT available_copies INTO avail
    FROM Books WHERE book_id = p_book_id;

    IF avail IS NULL THEN
        SET p_message = 'ERROR: Book not found.';
    ELSEIF avail = 0 THEN
        SET p_message = 'ERROR: No copies available.';
    ELSE
        INSERT INTO Borrowings
            (member_id, book_id, borrow_date, due_date, status)
        VALUES
            (p_member_id, p_book_id,
             CURRENT_DATE,
             DATE_ADD(CURRENT_DATE, INTERVAL 14 DAY),
             'Borrowed');

        UPDATE Books
        SET available_copies = available_copies - 1
        WHERE book_id = p_book_id;

        SET p_message = 'SUCCESS: Book borrowed for 14 days.';
    END IF;
END$$

-- ── Procedure: Return Book & Calculate Fine ───────────
CREATE PROCEDURE ReturnBook(
    IN  p_borrow_id INT,
    OUT p_fine      DECIMAL(8,2),
    OUT p_message   VARCHAR(200)
)
BEGIN
    DECLARE v_due    DATE;
    DECLARE v_book   INT;
    DECLARE v_member INT;
    DECLARE v_days   INT;

    SELECT due_date, book_id, member_id
    INTO   v_due, v_book, v_member
    FROM   Borrowings
    WHERE  borrow_id = p_borrow_id;

    SET v_days = DATEDIFF(CURRENT_DATE, v_due);

    IF v_days > 0 THEN
        SET p_fine = v_days * 25.00;
        INSERT INTO Fines
            (borrow_id, member_id, amount, reason)
        VALUES
            (p_borrow_id, v_member, p_fine,
             CONCAT('Late return: ', v_days, ' days × Rs.25'));
    ELSE
        SET p_fine = 0.00;
    END IF;

    UPDATE Borrowings
    SET return_date = CURRENT_DATE,
        status      = 'Returned',
        fine_amount = p_fine
    WHERE borrow_id = p_borrow_id;

    UPDATE Books
    SET available_copies = available_copies + 1
    WHERE book_id = v_book;

    SET p_message = CONCAT('SUCCESS: Returned. Fine = Rs.', p_fine);
END$$

DELIMITER ;


-- ── Call Procedures ───────────────────────────────────
CALL BorrowBook(2, 5, @msg);  SELECT @msg;
CALL ReturnBook(1, @fine, @msg);  SELECT @fine, @msg;


