-- ── 1. View All Books with Author ─────────────────────
SELECT
    b.book_id,
    b.title,
    a.full_name        AS author,
    b.genre,
    b.published_year,
    b.total_copies,
    b.available_copies,
    CASE
        WHEN b.available_copies = 0 THEN 'Not Available'
        ELSE 'Available'
    END                AS availability
FROM Books b
JOIN Authors a ON b.author_id = a.author_id
ORDER BY b.title;


-- ── 2. View All Active Members ────────────────────────
SELECT
    member_id,
    full_name,
    email,
    phone,
    join_date,
    status
FROM Members
WHERE status = 'Active'
ORDER BY join_date DESC;


-- ── 3. View All Current Borrowings ───────────────────
SELECT
    br.borrow_id,
    m.full_name       AS member,
    b.title           AS book,
    br.borrow_date,
    br.due_date,
    br.status,
    DATEDIFF(CURRENT_DATE, br.due_date) AS days_overdue
FROM Borrowings br
JOIN Members m ON br.member_id = m.member_id
JOIN Books   b ON br.book_id   = b.book_id
WHERE br.status IN ('Borrowed', 'Overdue')
ORDER BY br.due_date;


-- ── 4. Search Book by Title ───────────────────────────
SELECT
    b.title,
    a.full_name  AS author,
    b.genre,
    b.available_copies
FROM Books b
JOIN Authors a ON b.author_id = a.author_id
WHERE b.title LIKE '%Python%';


-- ── 5. Borrow a Book (Insert) ─────────────────────────
INSERT INTO Borrowings (member_id, book_id, borrow_date, due_date, status)
VALUES (6, 5, CURRENT_DATE, DATE_ADD(CURRENT_DATE, INTERVAL 14 DAY), 'Borrowed');

-- Decrease available copies
UPDATE Books
SET available_copies = available_copies - 1
WHERE book_id = 5 AND available_copies > 0;


-- ── 6. Return a Book (Update) ─────────────────────────
UPDATE Borrowings
SET return_date = CURRENT_DATE,
    status      = 'Returned'
WHERE borrow_id = 7;

-- Increase available copies
UPDATE Books
SET available_copies = available_copies + 1
WHERE book_id = (
    SELECT book_id FROM Borrowings WHERE borrow_id = 7
);


-- ── 7. Delete a Member ────────────────────────────────
DELETE FROM Members
WHERE member_id = 6
  AND member_id NOT IN (
      SELECT member_id FROM Borrowings WHERE status = 'Borrowed'
  );


