-- ── View: Available Books ─────────────────────────────
CREATE OR REPLACE VIEW AvailableBooks AS
SELECT
    b.book_id,
    b.title,
    a.full_name     AS author,
    b.genre,
    b.available_copies
FROM Books b
JOIN Authors a ON b.author_id = a.author_id
WHERE b.available_copies > 0;

-- ── View: Overdue Borrowings ──────────────────────────
CREATE OR REPLACE VIEW OverdueBorrowings AS
SELECT
    m.full_name,
    m.phone,
    b.title,
    br.due_date,
    DATEDIFF(CURRENT_DATE, br.due_date)      AS days_late,
    DATEDIFF(CURRENT_DATE, br.due_date) * 25 AS fine_rs
FROM Borrowings br
JOIN Members m ON br.member_id = m.member_id
JOIN Books   b ON br.book_id   = b.book_id
WHERE br.due_date < CURRENT_DATE
  AND br.status != 'Returned';

